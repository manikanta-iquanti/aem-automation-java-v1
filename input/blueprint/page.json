        },
        "mig_par": {
          "jcr:primaryType": "nt:unstructured",
          "body": "\u003Cp\u003EThe reunification express is not the bullet train. It is vinyl seats, sliding windows that actually open, and a corridor that smells faintly of jasmine tea and diesel.\u003C/p\u003E",
          "sling:resourceType": "my-aem-site53/components/meridian-article-paragraph",
          "textIsRich": "true",
          "dropCap": "true"
        },
        "mig_head": {
          "jcr:primaryType": "nt:unstructured",
          "anchorId": "why-sit-on-the-sea-side",
          "text": "Why sit on the sea side",
          "level": "h2",
          "sling:resourceType": "my-aem-site53/components/meridian-article-heading"
        },
        "mig_par_2": {
          "jcr:primaryType": "nt:unstructured",
          "body": "\u003Cp\u003EBetween Da Nang and Hue the line hugs the Hai Van pass in glimpses — turquoise chop, fishing boats like commas, then tunnels cool as a cellar.\u003C/p\u003E",
          "sling:resourceType": "my-aem-site53/components/meridian-article-paragraph",
          "textIsRich": "true",
          "dropCap": "false"
        },
        "mig_head_2": {
          "jcr:primaryType": "nt:unstructured",
          "anchorId": "what-to-bring-on-board",
          "text": "What to bring on board",
          "level": "h2",
          "sling:resourceType": "my-aem-site53/components/meridian-article-heading"
        },
        "mig_list": {
          "jcr:primaryType": "nt:unstructured",
          "sling:resourceType": "my-aem-site53/components/meridian-article-list",
          "listType": "unordered",
          "items": {
            "jcr:primaryType": "nt:unstructured",
            "item0": {
              "jcr:primaryType": "nt:unstructured",
              "text": "A light jacket — air conditioning oscillates between arctic and broken."
            },
            "item1": {
              "jcr:primaryType": "nt:unstructured",
              "text": "Snacks you actually want; the cart is optimistic but limited."
            },
            "item2": {
              "jcr:primaryType": "nt:unstructured",
              "text": "A fully charged phone and downloaded maps — tunnels are long storytellers."
            }
          }
        },
        "mig_head_3": {
          "jcr:primaryType": "nt:unstructured",
          "anchorId": "a-loose-afternoon-in-hue",
          "text": "A loose afternoon in Hue",
          "level": "h2",
          "sling:resourceType": "my-aem-site53/components/meridian-article-heading"
        },
        "mig_list_2": {
          "jcr:primaryType": "nt:unstructured",
          "sling:resourceType": "my-aem-site53/components/meridian-article-list",
          "listType": "ordered",
          "items": {
            "jcr:primaryType": "nt:unstructured",
            "item0": {
              "jcr:primaryType": "nt:unstructured",
              "text": "Walk the perimeter of the citadel walls at golden hour."
            },
            "item1": {
              "jcr:primaryType": "nt:unstructured",
              "text": "Eat bun bo Hue somewhere plastic stools outnumber menus."
            },
            "item2": {
              "jcr:primaryType": "nt:unstructured",
              "text": "End at a cafe overlooking the Perfume River with nothing urgent to do."
            }
          }
        },
        "mig_par_3": {
          "jcr:primaryType": "nt:unstructured",
          "body": "\u003Cp\u003E\u003Cem\u003EThe best seat is the one where you stop checking the time.\u003C/em\u003E\u003C/p\u003E",
          "sling:resourceType": "my-aem-site53/components/meridian-article-paragraph",
          "textIsRich": "true",
          "dropCap": "false"
        },
        "mig_callout": {
          "jcr:primaryType": "nt:unstructured",
          "eyebrow": "Etiquette note",
          "body": "\u003Cp class=\"text-foreground leading-relaxed m-0\"\u003EOffer snacks across the aisle once; refusal is polite, acceptance is friendship.\u003C/p\u003E",
          "sling:resourceType": "my-aem-site53/components/meridian-article-callout",
          "textIsRich": "true",
          "initial": "E"
        },
        "mig_head_4": {
          "jcr:primaryType": "nt:unstructured",
          "anchorId": "leaving",
          "text": "Leaving",
          "level": "h2",
          "sling:resourceType": "my-aem-site53/components/meridian-article-heading"
        },
        "mig_par_4": {
          "jcr:primaryType": "nt:unstructured",
          "body": "\u003Cp\u003EHue's station smells of rain on concrete. I stepped onto the platform with creased tickets and the sense that the coast had been narrated to me in the kindest slow voice.\u003C/p\u003E",
          "sling:resourceType": "my-aem-site53/components/meridian-article-paragraph",
          "textIsRich": "true",
          "dropCap": "false"
        },
