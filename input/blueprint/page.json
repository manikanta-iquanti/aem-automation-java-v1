          "publishDateText": "April 18, 2026",
          "authorName": "Lan Pham",
          "eyebrow": "Rail · Da Nang to Hue, Vietnam",
          "readTime": "9 min read",
          "imageAlt": "Train window view along a tropical coastline",
          "dek": "Sea on one side, jungle on the other, and a dining car that believes deeply in instant noodles.",
          "image": "https://images.unsplash.com/photo-1528127269322-539801943592?w=1600&q=80",
          "title": "Slow Train on Vietnam's Central Coast",
          "sling:resourceType": "my-aem-site53/components/meridian-article-hero"
        },
        "mig_jump": {
          "jcr:primaryType": "nt:unstructured",
          "sling:resourceType": "my-aem-site53/components/meridian-article-jump-links",
          "links": {
