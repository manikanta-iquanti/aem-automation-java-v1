                <mig_par
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="my-aem-site53/components/meridian-article-paragraph"
                    body="&lt;p>The reunification express is not the bullet train. It is vinyl seats, sliding windows that actually open, and a corridor that smells faintly of jasmine tea and diesel.&lt;/p>"
                    dropCap="true"
                    textIsRich="true"/>
                <mig_head
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="my-aem-site53/components/meridian-article-heading"
                    anchorId="why-sit-on-the-sea-side"
                    level="h2"
                    text="Why sit on the sea side"/>
                <mig_par_2
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="my-aem-site53/components/meridian-article-paragraph"
                    body="&lt;p>Between Da Nang and Hue the line hugs the Hai Van pass in glimpses — turquoise chop, fishing boats like commas, then tunnels cool as a cellar.&lt;/p>"
                    dropCap="false"
                    textIsRich="true"/>
                <mig_head_2
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="my-aem-site53/components/meridian-article-heading"
                    anchorId="what-to-bring-on-board"
                    level="h2"
                    text="What to bring on board"/>
                <mig_list
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="my-aem-site53/components/meridian-article-list"
                    listType="unordered">
                    <items jcr:primaryType="nt:unstructured">
                        <item0
                            jcr:primaryType="nt:unstructured"
                            text="A light jacket — air conditioning oscillates between arctic and broken."/>
                        <item1
                            jcr:primaryType="nt:unstructured"
                            text="Snacks you actually want; the cart is optimistic but limited."/>
                        <item2
                            jcr:primaryType="nt:unstructured"
                            text="A fully charged phone and downloaded maps — tunnels are long storytellers."/>
                    </items>
                </mig_list>
                <mig_head_3
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="my-aem-site53/components/meridian-article-heading"
                    anchorId="a-loose-afternoon-in-hue"
                    level="h2"
                    text="A loose afternoon in Hue"/>
                <mig_list_2
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="my-aem-site53/components/meridian-article-list"
                    listType="ordered">
                    <items jcr:primaryType="nt:unstructured">
                        <item0
                            jcr:primaryType="nt:unstructured"
                            text="Walk the perimeter of the citadel walls at golden hour."/>
                        <item1
                            jcr:primaryType="nt:unstructured"
                            text="Eat bun bo Hue somewhere plastic stools outnumber menus."/>
                        <item2
                            jcr:primaryType="nt:unstructured"
                            text="End at a cafe overlooking the Perfume River with nothing urgent to do."/>
                    </items>
                </mig_list_2>
                <mig_par_3
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="my-aem-site53/components/meridian-article-paragraph"
                    body="&lt;p>&lt;em>The best seat is the one where you stop checking the time.&lt;/em>&lt;/p>"
                    dropCap="false"
                    textIsRich="true"/>
                <mig_callout
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="my-aem-site53/components/meridian-article-callout"
                    body="&lt;p class=&quot;text-foreground leading-relaxed m-0&quot;>Offer snacks across the aisle once; refusal is polite, acceptance is friendship.&lt;/p>"
                    eyebrow="Etiquette note"
                    initial="E"
                    textIsRich="true"/>
                <mig_head_4
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="my-aem-site53/components/meridian-article-heading"
                    anchorId="leaving"
                    level="h2"
                    text="Leaving"/>
                <mig_par_4
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="my-aem-site53/components/meridian-article-paragraph"
                    body="&lt;p>Hue's station smells of rain on concrete. I stepped onto the platform with creased tickets and the sense that the coast had been narrated to me in the kindest slow voice.&lt;/p>"
                    dropCap="false"
                    textIsRich="true"/>
